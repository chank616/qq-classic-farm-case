<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup><PackageReference Include="Wasmtime" Version="48.0.2" /></ItemGroup>
  <ItemGroup>
    <Content Include="assets/tsdk.wasm" Link="tsdk.wasm" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="assets/licenses/*.txt" Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../qq-native-bridge/vendor/minhook-1.3.4/LICENSE.txt" Link="licenses/MinHook.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="assets/protocol.json" LogicalName="farm-protocol.json" />
    <EmbeddedResource Include="qq-session-provider.js" LogicalName="qq-session-provider.js" />
    <EmbeddedResource Include="../qq-native-bridge/bin/QQFarmBridge.sha256" LogicalName="QQFarmBridge.sha256" />
    <Content Include="../qq-native-bridge/bin/QQFarmBridge.dll" Link="QQFarmBridge.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Compile Include="../tray/Native/GateProtocol.cs" Link="GateProtocol.cs" />
  </ItemGroup>
</Project>
